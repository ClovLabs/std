{
	"name": "@clov-std/elysia-ratelimit",
	"version": "5.0.7",
	"description": "Rate limiting for Elysia as a route macro, with RFC 9457 429 responses and pluggable storage.",
	"keywords": [
		"elysia",
		"elysia-plugin",
		"rate-limit",
		"ratelimit"
	],
	"license": "MIT",
	"author": "Clov",
	"repository": {
		"type": "git",
		"url": "https://github.com/ClovLabs/std",
		"directory": "packages/elysia-ratelimit"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "bun builder.ts",
		"docs": "bunx typedoc --tsconfig tsconfig.build.json",
		"fmt:check": "oxfmt --check",
		"fmt": "oxfmt",
		"lint:fix": "oxlint --fix ./src",
		"lint:github": "oxlint --format=github ./src",
		"lint": "oxlint ./src",
		"test": "bun test --pass-with-no-tests --coverage"
	},
	"devDependencies": {
		"@clov-std/kv-store": "workspace:^",
		"@types/bun": "catalog:base",
		"oxfmt": "catalog:base",
		"oxlint": "catalog:base",
		"oxlint-tsgolint": "catalog:base",
		"typescript": "catalog:base"
	},
	"peerDependencies": {
		"@clov-std/kv-store": "workspace:^",
		"elysia": "catalog:elysia",
		"typebox": "^1.4.7"
	}
}
